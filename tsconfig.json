{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "bun"],
    "skipLibCheck": true
  },
  "include": ["src", "server", "scripts", "vite.config.ts"],
  "exclude": [
    "src/worker.ts",
    "src/worker-api.ts",
    "src/si-generation.ts",
    "src/atlas-manifest.ts",
    "src/fog-eligibility-index-cache.ts"
  ]
}
