# Server-only OpenRouter credential. Never expose this value through VITE_* variables.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-5.4-image-2
# Production requests are restricted to this origin.
ATLAS_ALLOWED_ORIGIN=https://romanticatlas.hype.hk
# Browser diagnostic: draw red boundaries around generated tiles found in the local cache.
VITE_DIAGNOSTIC_CACHED_TILES=false
