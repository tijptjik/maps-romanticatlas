{
  "name": "hong-kong-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun server/index.ts",
    "build": "vite build",
    "deploy": "VITE_DEPLOY_COMMIT=$(git rev-parse --verify HEAD) bun run build && wrangler deploy",
    "preview": "NODE_ENV=production bun server/index.ts",
    "dev:remote": "bun run build && wrangler dev --port 8787 --var ATLAS_ALLOWED_ORIGIN:http://localhost:8787 --var ATLAS_LOCAL_DEV:true",
    "sync:tiles": "bun scripts/sync-generated-tiles.ts",
    "backfill:manifest": "bun scripts/backfill-atlas-manifest.ts",
    "cache:warm:fog": "bun scripts/precompute-fog-index.ts",
    "generate:paper": "bun scripts/generate-paper-texture.ts",
    "generate:audio": "bun scripts/generate-atlas-audio.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "format": "biome format --write . && bun run format:markdown",
    "format:markdown": "prettier --write \"**/*.md\"",
    "format:markdown:check": "prettier --check \"**/*.md\"",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@cf-wasm/photon": "0.4.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@protomaps/basemaps": "^5.7.2",
    "maplibre-gl": "^6.6.0",
    "pbf": "^5.1.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "playwright": "1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  }
}
