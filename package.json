{
  "name": "hong-kong-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun server/index.js",
    "build": "vite build",
    "deploy": "bun run build && wrangler deploy",
    "preview": "NODE_ENV=production bun server/index.js",
    "generate:paper": "bun scripts/generate-paper-texture.js",
    "format": "biome format --write . && bun run format:markdown",
    "format:markdown": "prettier --write \"**/*.md\"",
    "format:markdown:check": "prettier --check \"**/*.md\"",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@mapbox/vector-tile": "^2.0.4",
    "@protomaps/basemaps": "^5.7.2",
    "maplibre-gl": "^5.24.0",
    "pbf": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "prettier": "^3.9.6",
    "vite": "^7.0.0",
    "wrangler": "^4.102.0"
  }
}
