{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hong-kong-romantic-atlas",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-18",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/map-assets/hype/*"]
  }
}
