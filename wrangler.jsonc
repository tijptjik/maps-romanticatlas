{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maps-visionarymachines",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-18",
  "workers_dev": true,
  "routes": [
    { "pattern": "romanticatlas.hype.hk", "custom_domain": true }
  ],
  "vars": {
    "ATLAS_ALLOWED_ORIGIN": "https://romanticatlas.hype.hk",
    "OPENROUTER_MODEL": "openai/gpt-5.4-image-2"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/map-assets/saanseoi/*"]
  }
}
